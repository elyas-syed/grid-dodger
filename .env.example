# Optional — game-over recap (Phase 4+). Leave unset to skip.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Local Strands Decider HTTP server (Phase 3+)
DECIDER_URL=http://127.0.0.1:8000
DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v19

# Policy (UI default 0.40 for grid domain; SPEC still documents 0.55 as general default)
DECIDER_CONFIDENCE_THRESHOLD=0.40
DECIDER_DEVICE=mps
